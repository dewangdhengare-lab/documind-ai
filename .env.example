# DocuMind AI Configuration
# Get a free API key at https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here

# Model Identifier
LLM_MODEL=llama-3.1-8b-instant

# Embedding Model (runs locally with sentence-transformers, no key needed)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Storage Directories
UPLOAD_DIR=uploads
CHROMA_DB_DIR=chroma_db
DATABASE_URL=sqlite:///./documind.db

# Ingestion Limits
MAX_FILE_SIZE_MB=50
CHUNK_SIZE=500
CHUNK_OVERLAP=50
TOP_K=5
